# --- Pal Opt (AIO) 環境変数 ---

# セッションCookie署名用シークレット（必須・十分に長いランダム文字列）
SESSION_SECRET=

# pal_db proxy（顧客認証・契約照合）
# 本番: https://palettecrm.vercel.app/api/pal-db または https://pal-db.onrender.com
PAL_DB_BASE_URL=https://pal-db.onrender.com

# DB (Neon)
POSTGRES_URL=postgresql://...

# AI計測
OPENAI_KEY_API=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
